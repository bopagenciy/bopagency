# =============================================================================
# n8n-local/.env.example
# Plantilla de configuración LOCAL para n8n (Docker). Copiar a n8n-local/.env
# y completar valores. n8n-local/.env NUNCA se commitea (ver .gitignore).
#
# Este archivo NO contiene valores reales — son placeholders.
# =============================================================================

# --- n8n core ---
N8N_PORT=5678
N8N_HOST=localhost
N8N_PROTOCOL=http

# --- Timezone ---
GENERIC_TIMEZONE=America/Bogota
TZ=America/Bogota

# --- Clave de cifrado interna de n8n (credenciales guardadas en n8n) ---
# Generar localmente, por ejemplo:
#   openssl rand -base64 48
# NUNCA reutilizar una clave de un entorno productivo. NUNCA commitear el valor real.
N8N_ENCRYPTION_KEY=replace-with-a-locally-generated-random-key

# --- Telemetría / personalización (desactivadas en local) ---
N8N_DIAGNOSTICS_ENABLED=false
N8N_PERSONALIZATION_ENABLED=false

# --- URL base que n8n usa para mostrar/construir sus propias webhook URLs ---
WEBHOOK_URL=http://localhost:5678/

# --- Acceso a filesystem restringido a los volúmenes montados ---
N8N_RESTRICT_FILE_ACCESS_TO=/agencia-ai;/shared-data;/files

# --- Permite que los nodos Code lean variables de entorno (ej. AUTOMATION_WEBHOOK_SECRET) ---
# Necesario para que n8n-local/workflows/phase6-local-runtime-test.json pueda
# leer AUTOMATION_WEBHOOK_SECRET vía $env dentro del nodo Code de firma HMAC.
#
# ⚠️ RIESGO ACEPTADO SOLO EN LOCAL: con este valor en `false`, CUALQUIER nodo
# Code del workflow (incluidos futuros nodos añadidos por error) puede leer
# TODAS las variables de entorno del contenedor, no solo AUTOMATION_WEBHOOK_SECRET.
# En un entorno productivo o compartido esto NO es recomendable — ahí se
# debería preferir `true` (bloqueado) y usar credenciales de n8n (Vault del
# lado de n8n) en vez de $env para secretos. Se acepta aquí únicamente porque
# esto es un contenedor local, de un solo usuario, sin datos reales.
N8N_BLOCK_ENV_ACCESS_IN_NODE=false

# --- Secreto HMAC compartido con BopIAgency (Phase 6) ---
# DEBE ser exactamente el mismo valor que AUTOMATION_WEBHOOK_SECRET en
# apps/web/.env.local. Generar SOLO localmente (ver
# docs/implementation/phase-6/PHASE_6_LOCAL_N8N_SETUP.md, paso 3).
# NUNCA commitear el valor real. NUNCA imprimirlo en logs.
AUTOMATION_WEBHOOK_SECRET=replace-with-the-same-32-byte-secret-as-env-local
