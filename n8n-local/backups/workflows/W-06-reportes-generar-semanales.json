    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "function getIsoWeek(date) {\n  const target = new Date(Date.UTC(\n    date.getUTCFullYear(),\n    date.getUTCMonth(),\n    date.getUTCDate()\n  ));\n\n  const dayNumber = target.getUTCDay() || 7;\n  target.setUTCDate(target.getUTCDate() + 4 - dayNumber);\n\n  const yearStart = new Date(Date.UTC(target.getUTCFullYear(), 0, 1));\n\n  const weekNumber = Math.ceil(\n    (((target - yearStart) / 86400000) + 1) / 7\n  );\n\n  return {\n    year: target.getUTCFullYear(),\n    week: weekNumber,\n  };\n}\n\nconst now = new Date();\n\nconst previousWeekDate = new Date(now);\npreviousWeekDate.setUTCDate(previousWeekDate.getUTCDate() - 7);\n\nconst { year, week } = getIsoWeek(previousWeekDate);\n\nreturn {\n  ...$json,\n  reportType: 'weekly',\n  period: `${year}-W${String(week).padStart(2, '0')}`,\n};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -80,
        -80
      ],
      "id": "74f324f8-55f5-4f24-bcc3-f3ef6ea8596d",
      "name": "Calcular periodo semanal"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://host.docker.internal:3101/api/reports/generate-all",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{\n  {\n    reportType: $json.reportType,\n    period: $json.period\n  }\n}}",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [
        80,
        -80
      ],
      "id": "0807a715-dc03-48e0-ba11-643aa26f8052",
      "name": "Generar reportes semanales"
    },
    {
