# ============================================================================
# BopIAgency — Variables de Entorno
# ============================================================================
# Copia este archivo a .env.local y completa los valores reales.
# NUNCA subas .env.local a git.
# ============================================================================

# --- Supabase (REQUERIDO para Fase 2) ---

# URL pública del proyecto Supabase (visible en Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Clave anon/pública de Supabase (visible en Project Settings > API)
# Es seguro exponer esta clave al browser si las RLS policies son la protección.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Service Role Key de Supabase — SOLO EN SERVIDOR, NUNCA CON PREFIJO NEXT_PUBLIC_
# Bypassea RLS. Usada ÚNICAMENTE en código explícitamente server-side.
# Obtener en: Project Settings > API > service_role key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# --- App (OPCIONAL para Fase 2 — REQUERIDO para Phase 6 — dispatch/callback n8n) ---

# URL base de la aplicación (sin trailing slash). Usada para construir
# redirects de auth Y, desde Phase 6, para construir callbackUrl del
# dispatch hacia n8n (N8nWebhookDispatcher.resolveCallbackUrl agrega
# /api/webhooks/n8n al origin de esta variable — nunca acepta ese path
# desde input del cliente). Local: http://localhost:3200 (callbackUrl final:
# http://localhost:3200/api/webhooks/n8n).
NEXT_PUBLIC_APP_URL=http://localhost:3200

# Entorno (development | production | test)
NODE_ENV=development

# --- n8n / Automation Runtime (REQUERIDO para Phase 6 — dispatch + callbacks) ---
# Ver contrato completo en:
#   packages/infrastructure/src/n8n/n8n-webhook-dispatcher.ts
#   apps/web/src/lib/webhooks/hmac.ts
#   apps/web/src/app/api/webhooks/n8n/route.ts
#   docs/implementation/phase-6/PHASE_6_LOCAL_N8N_SETUP.md

# URL base de n8n, SIN trailing slash y SIN el path /webhook.
# El dispatcher construye la URL final como: {N8N_BASE_URL}/webhook/{automationId}
# Local (n8n en Docker, Next.js en el host): http://localhost:5678
# NUNCA apuntar a un n8n productivo (ej: n8n.bopagency.com) desde .env.local.
N8N_BASE_URL=http://localhost:5678

# NOTA: N8N_WEBHOOK_PATH está documentada aquí como referencia futura, pero
# el código actual (N8nWebhookDispatcher) NO la lee — el path se construye
# de forma fija como `/webhook/{automationId}`. No tiene efecto todavía.
N8N_WEBHOOK_PATH=/webhook

# NOTA: el campo callbackUrl que BopIAgency envía en el dispatch NO se
# configura aquí — se construye automáticamente a partir de
# NEXT_PUBLIC_APP_URL (ver arriba) + /api/webhooks/n8n, siempre server-side.

# Secreto compartido HMAC SHA-256 entre BopIAgency y n8n (≥32 caracteres).
# Firma: hex(HMAC_SHA256(AUTOMATION_WEBHOOK_SECRET, `${timestamp}.${rawBody}`))
# Generar SOLO localmente (ver PHASE_6_LOCAL_N8N_SETUP.md, paso 3).
# NUNCA commitear el valor real. Debe coincidir exactamente con el valor
# configurado en n8n-local/.env.
AUTOMATION_WEBHOOK_SECRET=replace-with-a-locally-generated-32-byte-random-secret

# API key de n8n — SOLO necesaria si se usa N8nWebhookDispatcher.cancel()
# (DELETE /api/v1/executions/{runId}). Opcional para el flujo de dispatch/callback.
N8N_API_KEY=

# Timeout del dispatch saliente hacia n8n, en milisegundos.
# Default si se omite: 10000. Rango válido: 1000–60000.
N8N_DISPATCH_TIMEOUT_MS=10000

# Tolerancia de timestamp para callbacks entrantes, en segundos.
# Default si se omite: 300. Rango válido: 30–3600.
AUTOMATION_WEBHOOK_TOLERANCE_SECONDS=300

# --- Campaign Studio AI — multi-provider (Phase 7D.1) -------------------------
# Ver:
#   packages/infrastructure/src/ai/ai-provider-config.ts   (única lectura de env)
#   packages/infrastructure/src/ai/campaign-ai-provider.factory.ts
#   docs/implementation/phase-7/PHASE_7D1_MULTI_PROVIDER_AI_REPORT.md
#
# NINGUNA de estas variables usa el prefijo NEXT_PUBLIC_: son secretos y
# configuración de servidor. El browser solo puede elegir un provider id de un
# enum cerrado ('openai' | 'gemini' | 'anthropic'); jamás una API key, un
# modelo ni una URL de API.
#
# NUNCA commitear valores reales.

# Proveedor por defecto cuando la UI no envía uno explícito.
# Valores válidos: openai | gemini | anthropic
# Si se omite: 'anthropic' (default documentado, compatible con Phase 7D).
# Un valor NO reconocido produce un error de configuración explícito — NO se
# cae en silencio a otro proveedor.
CAMPAIGN_AI_DEFAULT_PROVIDER=gemini

# OpenAI (API pública, NO ChatGPT web).
OPENAI_API_KEY=
# Default si se omite: gpt-4o-mini
OPENAI_MODEL=

# Google Gemini (Generative Language API). La key viaja en el header
# x-goog-api-key, nunca como query param.
GEMINI_API_KEY=
# Default si se omite: gemini-3.6-flash
# (Phase 7D.1.1 — antes gemini-1.5-flash, ya obsoleto.)
GEMINI_MODEL=

# Anthropic Claude (Messages API). "Claude Code" es tooling de desarrollo y NO
# interviene en runtime — el proveedor real es esta API.
ANTHROPIC_API_KEY=
# Default si se omite: claude-3-5-sonnet-20241022
# ⚠️ Este default NO ha sido verificado en un smoke real y probablemente esté
# obsoleto: fija aquí un modelo vigente antes de usar el proveedor 'anthropic'.
ANTHROPIC_MODEL=
# Default si se omite: 2023-06-01 (header anthropic-version)
ANTHROPIC_API_VERSION=

# --- Timeout y reintentos de IA (Phase 7D.1.1) --------------------------------
# Motivo del cambio: en el smoke real, la generación inicial con Gemini
# funcionó, pero la REGENERACIÓN superó los 30 s y abortó con timeout.

# Timeout de CADA intento, en milisegundos.
# Default si se omite: 60000 (antes 30000). Rango válido: 5000–120000.
CAMPAIGN_AI_TIMEOUT_MS=60000

# Intentos totales (1 inicial + reintentos) ante errores TRANSITORIOS
# (429, 500, 502, 503, 504, errores de red y timeout). Nunca se reintenta un
# 400/401/403, una configuración inválida ni una salida que no cumple el schema.
# Tampoco hay fallback automático a otro proveedor.
# Default si se omite: 3. Rango válido: 1–3.
CAMPAIGN_AI_MAX_ATTEMPTS=3

# Backoff exponencial entre reintentos: base, base×2, base×4…
# Default si se omite: 500. Rango válido: 0–10000.
CAMPAIGN_AI_RETRY_BASE_DELAY_MS=500

# Cota DURA del tiempo total de la operación (todos los intentos + backoff),
# para que subir el timeout por intento no descontrole la espera del usuario.
# Default si se omite: el doble de CAMPAIGN_AI_TIMEOUT_MS (máx. 240000).
# Rango válido: 5000–240000.
CAMPAIGN_AI_TOTAL_BUDGET_MS=120000
