    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const now = new Date();\n\nconst previousMonth = new Date(\n  Date.UTC(now.getUTCFullYear(), now.getUTCMonth() - 1, 1)\n);\n\nconst year = previousMonth.getUTCFullYear();\nconst month = String(previousMonth.getUTCMonth() + 1).padStart(2, '0');\n\nreturn {\n  ...$json,\n  reportType: 'monthly',\n  period: `${year}-${month}`,\n};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -32,
        -64
      ],
      "id": "50182932-ef7e-46b6-8911-697d27b2c159",
      "name": "Calcular periodo del reporte"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://host.docker.internal:3101/api/reports/generate-all",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{\n  {\n    reportType: $json.reportType,\n    period: $json.period\n  }\n}}",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
