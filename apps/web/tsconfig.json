{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "ES2022"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./src/*"],
      "@bop-agency/ui": ["../../packages/ui/src/index.ts"],
      "@bop-agency/shared": ["../../packages/shared/src/index.ts"],
      "@bop-agency/domain": ["../../packages/domain/src/index.ts"],
      "@bop-agency/application": ["../../packages/application/src/index.ts"],
      "@bop-agency/ai-engine": ["../../packages/ai-engine/src/index.ts"],
      "@bop-agency/infrastructure": ["../../packages/infrastructure/src/index.ts"],
      "@bop-agency/automation-engine": ["../../packages/automation-engine/src/index.ts"]
    },
    "noEmit": true
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  "exclude": ["node_modules", ".next"]
}
