    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const now = new Date();\n\nconst previousMonth = new Date(\n  Date.UTC(now.getUTCFullYear(), now.getUTCMonth() - 1, 1)\n);\n\nconst year = previousMonth.getUTCFullYear();\nconst month = String(previousMonth.getUTCMonth() + 1).padStart(2, '0');\n\nreturn {\n  ...$json,\n  reportType: 'monthly',\n  period: `${year}-${month}`,\n};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -48,
        -80
      ],
      "id": "5b65cb9d-9a12-4191-8d7d-05a1f3c368f2",
      "name": "Calcular periodo del reporte"
    },
    {
      "parameters": {
        "url": "={{\n  'http://host.docker.internal:3101/api/report-deliveries/pending' +\n  '?reportType=monthly' +\n  '&period=' +\n  encodeURIComponent(\n    $('Calcular periodo del reporte').first().json.period\n  ) +\n  '&limit=20'\n}}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {}
