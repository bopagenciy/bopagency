# ============================================================================
# BopIAgency — Variables de Entorno
# ============================================================================
# Copia este archivo a .env.local y completa los valores reales.
# NUNCA subas .env.local a git.
# ============================================================================

# --- Supabase (REQUERIDO para Fase 2) ---

# URL pública del proyecto Supabase (visible en Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Clave anon/pública de Supabase (visible en Project Settings > API)
# Es seguro exponer esta clave al browser si las RLS policies son la protección.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Service Role Key de Supabase — SOLO EN SERVIDOR, NUNCA CON PREFIJO NEXT_PUBLIC_
# Bypassea RLS. Usada ÚNICAMENTE en código explícitamente server-side.
# Obtener en: Project Settings > API > service_role key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# --- App (OPCIONAL para Fase 2) ---

# URL base de la aplicación (sin trailing slash)
NEXT_PUBLIC_APP_URL=http://localhost:3200

# Entorno (development | production | test)
NODE_ENV=development