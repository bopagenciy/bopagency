        "method": "POST",
        "url": "http://host.docker.internal:3101/api/automations/reports-generate-monthly/executions",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{\n  {\n    status: 'success',\n    startedAt: $('Contexto de ejecución').first().json.startedAt,\n    finishedAt: $now.toISO(),\n    durationMs: Date.now() - new Date(\n      $('Contexto de ejecución').first().json.startedAt\n    ).getTime(),\n    error: null,\n    executionId: $('Contexto de ejecución').first().json.executionId,\n    metadata: {\n      source: 'n8n',\n      workflowName: 'REPORTES - Generar Reportes Mensuales',\n      reportType: $('Calcular periodo del reporte').first().json.reportType,\n      period: $('Calcular periodo del reporte').first().json.period,\n      result: 'reports_generated'\n    }\n  }\n}}",
        "options": {}
