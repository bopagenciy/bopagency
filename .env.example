# Supabase — público y seguro para cliente
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Supabase — solo servidor, nunca usar prefijo NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# n8n Gateway — solo servidor, Phase 6C
# URL base de n8n. En desarrollo local:
N8N_BASE_URL=http://localhost:5678

# Secreto HMAC compartido entre BopIAgency y n8n.
# Generar con: openssl rand -hex 32
# Mínimo 32 caracteres. Nunca usar NEXT_PUBLIC_. Nunca registrar en logs.
AUTOMATION_WEBHOOK_SECRET=generate-with-openssl-rand-hex-32

# API key de n8n para operaciones REST futuras.
# Configurar en n8n: Settings > API > Create API Key
N8N_API_KEY=your-n8n-api-key-here

# Ventana de tolerancia para replay protection, en segundos.
# Default: 300. Rango válido: 30–3600.
# AUTOMATION_WEBHOOK_TOLERANCE_SECONDS=300

# Timeout para dispatch hacia n8n, en milisegundos.
# Default: 10000.
# N8N_DISPATCH_TIMEOUT_MS=10000

# Campaign Studio AI — multi-provider, solo servidor (Phase 7D.1)
# Nunca usar NEXT_PUBLIC_. Nunca registrar en logs. Nunca commitear valores reales.
# Detalle completo y defaults en apps/web/.env.example.
CAMPAIGN_AI_DEFAULT_PROVIDER=gemini
OPENAI_API_KEY=
OPENAI_MODEL=
GEMINI_API_KEY=
GEMINI_MODEL=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
ANTHROPIC_API_VERSION=
# Timeout POR INTENTO (Phase 7D.1.1: 30000 → 60000 tras el timeout observado
# en la regeneración con Gemini). Detalle y rangos en apps/web/.env.example.
CAMPAIGN_AI_TIMEOUT_MS=60000
CAMPAIGN_AI_MAX_ATTEMPTS=3
CAMPAIGN_AI_RETRY_BASE_DELAY_MS=500
CAMPAIGN_AI_TOTAL_BUDGET_MS=120000
